/*
 * Minimal inferCNV pipeline configuration.
 * Params live here so command lines stay short and reproducible.
 */

manifest {
    name            = 'minimal-infercnv'
    description     = 'A compact DSL2 Nextflow pipeline wrapping one inferCNV module'
    author          = 'Youssef Abili'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    /*
     * Input files
     */
    raw_counts_matrix = null
    annotations_file  = null
    gene_order_file   = null
    sample_id         = null

    /*
     * inferCNV settings
     */
    ref_group_names   = []
    annotations_delim = '\t'
    cutoff            = 0.1
    cluster_by_groups = true
    denoise           = true
    hmm               = false

    /*
     * Runtime and outputs
     */
    outdir            = 'results'
    publish_dir_mode  = 'copy'
    infercnv_cpus     = 4
    infercnv_memory   = '16.GB'
    infercnv_time     = '12.h'

    /*
     * Optional: set this to an image that contains R and the infercnv package.
     * Example usage:
     *   nextflow run . -profile docker --infercnv_container '<your-image>'
     */
    infercnv_container = null
}

process {
    executor = 'local'
    errorStrategy = 'terminate'

    withLabel: process_medium {
        cpus   = params.infercnv_cpus
        memory = params.infercnv_memory
        time   = params.infercnv_time
    }

    withName: INFERCNV {
        publishDir = [
            path: "${params.outdir}/infercnv",
            mode: params.publish_dir_mode
        ]
        container =  "quay.io/biocontainers/bioconductor-infercnv:1.26.0--r45hdfd78af_0"

    }
}

profiles {
    docker {
        docker.enabled = true
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    conda {
        conda.enabled = true
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
